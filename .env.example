# Build-time config: flutter run --dart-define-from-file=.env
# Release builds use env/prod.json (see README).
APP_ENV=dev
API_URL=http://10.0.2.2:7000/api
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx_or_legacy_anon_key
USE_EMAIL_AUTH=true
ENABLE_PHONE_OTP=false
ENABLE_DEMO_LOGIN=false
DEMO_PASSWORD=
DEV_MODE_HINT=false
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_WEB_API_KEY=
